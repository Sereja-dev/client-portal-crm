{
  "name": "aqenra-ai-provider-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated, manual-only Anthropic-vs-OpenAI provider/model benchmark harness for Aqenra. Never installed, built, or run by the main app or its default CI — see README.md.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "extract": "cd ../.. && node_modules/.bin/tsx --conditions=react-server scripts/ai-provider-eval/extract-fixtures.ts",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "dry-run": "tsx index.ts --dry-run",
    "validate": "tsx index.ts --validate",
    "eval": "tsx index.ts",
    "report": "tsx index.ts --report",
    "run": "tsx index.ts --run",
    "canary": "tsx index.ts --canary",
    "subset:preview": "tsx index.ts --subset-preview",
    "subset": "tsx index.ts --subset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "openai": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "tsx": "^4"
  }
}
